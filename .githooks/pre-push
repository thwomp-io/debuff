#!/usr/bin/env bash
# The gate pulls its own lever: any tag, or any push to main that changes VERSION, runs the whole
# gate first. Other pushes pass straight through.
# Break-glass: git push --no-verify (say why in the commit). Fresh clone: git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
run_gate=0
zero='^0+$'
while read -r _local_ref local_sha remote_ref remote_sha; do
	[[ "$local_sha" =~ $zero ]] && continue # a deletion releases nothing
	[[ "$remote_ref" == refs/tags/* ]] && run_gate=1
	[[ "$remote_ref" == refs/heads/main ]] || continue
	if [[ "$remote_sha" =~ $zero ]]; then
		git show --name-only --format= "$local_sha" | grep -qx 'internal/version/VERSION' && run_gate=1
	else
		git diff --name-only "$remote_sha" "$local_sha" | grep -qx 'internal/version/VERSION' && run_gate=1
	fi
done
if [[ $run_gate -eq 1 ]]; then
	echo "pre-push: release moment (a tag or a version bump): running the gate"
	# stdin is the ref list we already consumed; the gate reads nothing from it.
	./scripts/gate.sh </dev/null || {
		echo "✗ pre-push: gate failed, push blocked"
		exit 1
	}
fi
exit 0
